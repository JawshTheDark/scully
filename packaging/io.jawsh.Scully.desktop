[Desktop Entry]
Type=Application
Name=Scully
GenericName=IRC Client
Comment=Native client for a Lurker IRC bouncer
Exec=scully
Icon=io.jawsh.Scully
Terminal=false
Categories=Network;InstantMessaging;IRC;
Keywords=IRC;chat;lurker;bouncer;
StartupNotify=true
StartupWMClass=scully
# Phosh and other mobile shells read this to decide whether an app belongs in a
# phone's launcher. Scully switches to a single-pane layout under 640px, so it
# genuinely does.
X-Purism-FormFactor=Workstation;Mobile;
